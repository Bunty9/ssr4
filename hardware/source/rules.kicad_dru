(version 1)
# ssr4 mains safety rules. Source of the numbers: spec/requirements.md "Electrical safety (230 V)"
# (pcbparts protection/isolation: IEC 62368-1 / IEC 60664-1, PD2, FR4 group IIIa, OVC II).
# `uv run pcb drc` copies this file next to the generated board; kicad-cli DRC reads it there.
# Every 230 V net is in net class "Mains" (set in the circuit code). Later rules win in KiCad.

# Reinforced insulation, mains to everything low-voltage (SELV): ESP, USB, LEDs, drivers.
# Clearance is set to the creepage figure (6.5 mm), above the 3.6 mm reinforced clearance: on a
# flat board without slots the surface path is never shorter than the air gap, so this keeps
# copper pours far enough away for creepage too (KiCad zone fill obeys clearance, not creepage).
(rule "mains to SELV clearance (reinforced, = creepage on a flat board)"
  (condition "A.NetClass == 'Mains' && B.NetClass != 'Mains'")
  (constraint clearance (min 6.5mm)))

(rule "mains to SELV creepage (reinforced, rounded up from 6.4 mm)"
  (condition "A.NetClass == 'Mains' && B.NetClass != 'Mains'")
  (constraint creepage (min 6.5mm)))

# Basic insulation between different mains conductors (L-N, channel to channel, L_IN-L_OUT).
(rule "mains to mains clearance (basic)"
  (condition "A.NetClass == 'Mains' && B.NetClass == 'Mains' && A.Net != B.Net")
  (constraint clearance (min 1.8mm)))

(rule "mains to mains creepage (basic)"
  (condition "A.NetClass == 'Mains' && B.NetClass == 'Mains' && A.Net != B.Net")
  (constraint creepage (min 2.5mm)))

# SMD pads on GND connect solidly to the pour (reflow assembly): a thermal relief on a small pad
# next to other copper can end up with one spoke (starved_thermal). THT pads keep their reliefs.
(rule "GND SMD pads solid to the pour"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && A.NetName == 'GND'")
  (constraint zone_connection solid))

# Low-voltage signal clearance tolerance (2026-10-29). The board's design clearance is 0.2 mm
# (Default net class); boardforge's A* pre-router plans tracks exactly at it and float rounding
# left two of them 0.197 / 0.198 mm from a neighbour. 0.195 mm accepts that rounding and is still
# well above JLCPCB's 0.16 mm minimum (fab/jlcpcb.toml). Mains rules above are unaffected (they
# match on net class Mains, and the routers never see this rule).
(rule "low-voltage signal clearance (A* rounding tolerance)"
  (condition "A.NetClass == 'Default' && B.NetClass == 'Default'")
  (constraint clearance (min 0.195mm)))
